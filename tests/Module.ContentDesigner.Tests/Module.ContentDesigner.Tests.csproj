       per-view settings), the canvas attributes on the rendered page and the session's undo. No browser, no host. -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The client SDK the host provides to client modules (ILiveChannel for the hot reload tests). -->
  <ItemGroup>
    <PackageReference Include="soft.square.net.ModularBlazor.Abstractions" Version="$(ModularBlazorPlatformVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Module.ContentDesigner\Module.ContentDesigner.csproj" />
    <ProjectReference Include="..\..\src\WebApi.Modules.ContentDesigner.Client\WebApi.Modules.ContentDesigner.Client.csproj" />
    <ProjectReference Include="..\..\src\ContentDesigner.Rendering\ContentDesigner.Rendering.csproj" />
  </ItemGroup>

</Project>
