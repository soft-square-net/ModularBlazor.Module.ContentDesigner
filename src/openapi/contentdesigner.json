{
  "openapi": "3.1.1",
  "info": {
    "title": "ContentDesigner",
    "description": "Content Designer: the four-view arrangement of posts (Mobile, Tablet, Desktop, AMP), document and block templates, the design checks, and the server HTML and AMP pages.",
    "version": "0.2.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
