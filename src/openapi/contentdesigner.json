    "/api/contentdesigner/designs": {
      "get": {
        "tags": [
          "Designs"
        ],
        "summary": "One page of post designs, the latest change first; optionally of one kind.",
        "operationId": "ContentDesigner_ListDesigns",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          },
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesignPage"
                }
              }
            }
          }
        }
      }
    },
