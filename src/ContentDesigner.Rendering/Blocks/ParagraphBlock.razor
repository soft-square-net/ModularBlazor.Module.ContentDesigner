@namespace soft.square.net.ContentDesigner.Rendering.Blocks
@inherits BlockComponent
@*
  block.paragraph: formatted text. DynamicFields' rich text is plain text for now, so it is encoded, never trusted as
  HTML: a blank line starts a new paragraph, a line break is a <br>.
*@
@if (Context.Text("text") is { } text)
{
    <div @attributes="Context.Attributes">
        @foreach (var paragraph in Paragraphs(text))
        {
            <p>
                @for (var i = 0; i < paragraph.Length; i++)
                {
                    if (i > 0)
                    {
                        <br />
                    }
                    @paragraph[i]
                }
            </p>
        }
    </div>
}

@code {
    internal static IEnumerable<string[]> Paragraphs(string text) =>
        text.Replace("\r\n", "\n").Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(p => p.Split('\n', StringSplitOptions.TrimEntries));
}
