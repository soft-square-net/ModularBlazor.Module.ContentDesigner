@namespace soft.square.net.ContentDesigner.Rendering.Blocks
@inherits BlockComponent
@* block.video: a file plays in <video>; a YouTube or Vimeo address (or an embedUrl value) in an <iframe>. *@
@if (Embed.Of(Context, "video") is { } video)
{
    var (media, outer) = Context.Split("aspect");
    <figure @attributes="outer">
        <div @attributes="media">
            @if (video.IsEmbed)
            {
                <iframe src="@video.Url" title="@(Context.Text("title") ?? "")" loading="lazy" allowfullscreen allow="encrypted-media; picture-in-picture"></iframe>
            }
            else
            {
                <video src="@video.Url" controls preload="metadata" poster="@Context.Asset("thumbnail")?.Url" title="@Context.Text("title")"></video>
            }
        </div>
        <Caption Context="Context" Keys="@(["title", "description"])" />
    </figure>
}
