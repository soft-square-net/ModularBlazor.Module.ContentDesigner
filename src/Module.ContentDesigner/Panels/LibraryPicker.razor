@using soft.square.net.ContentDesigner.Rendering
@inject IHttpClientFactory HttpClients
@*
  "Add existing content": Content's shared library, filtered by block field, stage and unit, without the contents
  the post has already. A floating panel, not a modal: its rows are palette items, so one can be dragged straight onto
  the canvas (added to the post, then placed where it lands). Selecting a row previews it with its block renderer; "Add"
  puts it in the post, unplaced (it shows through "items") or in the selected region. Not required by default.
*@

<section class="cd-floating cd-library" role="dialog" aria-modal="false" aria-labelledby="cd-library-title" @onkeydown="OnKey">
  <header class="cd-floating__head">
    <h3 id="cd-library-title" class="cd-section__title">Add existing content</h3>
    <button type="button" class="mud-button-root mud-button-text mud-button-small" aria-label="Close" @onclick="Close">✕</button>
  </header>

  <form class="cd-library__filters" @onsubmit="() => SearchAsync(reset: true)" @onsubmit:preventDefault>
    <select class="cd-select" aria-label="Block field" @bind="_field">
      <option value="">Any block field</option>
      @foreach (var field in Fields)
      {
        <option value="@field">@RenderMapping.Label(field) (@field)</option>
      }
    </select>
    <select class="cd-select" aria-label="Stage" @bind="_stage">
      <option value="">Any stage</option>
      @foreach (var stage in StudioText.Stages)
      {
        <option value="@stage">@StudioText.Stage(stage)</option>
      }
    </select>
    @if (_units.Count > 0)
    {
      <select class="cd-select" aria-label="Unit" @bind="_unit">
        <option value="">Any unit</option>
        @foreach (var unit in _units)
        {
          <option value="@unit.Id">@StudioText.Unit(unit.Id, unit.NameEn, unit.NameAr)</option>
        }
      </select>
    }
    <button type="submit" class="mud-button-root mud-button-outlined mud-button-primary mud-button-small" disabled="@_loading">Search</button>
  </form>

  <div class="cd-library__body">
    <ul class="cd-list cd-library__list" role="listbox" aria-label="Library">
      @foreach (var item in Shown)
      {
        <li class="cd-list__item cd-palette @(_selected?.Content.ContentId == item.ContentId ? "is-selected" : "")" @key="item.ContentId"
            role="option" aria-selected="@(_selected?.Content.ContentId == item.ContentId)" tabindex="0"
            @attributes="Palette.Attributes(Palette.Library(item.ContentId))" title="Drag onto the canvas, or select to preview"
            @onclick="() => PreviewAsync(item)" @onkeydown="e => RowKey(e, item)">
          <span class="cd-list__main">
            <span class="cd-list__title">@RenderMapping.Label(item.FieldKey) <span class="cd-muted">@Short(item.ContentId)</span></span>
            <span class="cd-list__meta">
              <span class="@StudioText.StageClass(item.Stage)">@StudioText.Stage(item.Stage)</span>
              @if (item.UnitId is { } unitId) { <span class="cd-tag cd-tag--unit">@UnitLabel(unitId)</span> }
              <span class="cd-muted">@item.UpdatedAt.ToLocalTime().ToString("g")</span>
            </span>
          </span>
        </li>
      }
    </ul>
    @if (_loading)
    {
      <p class="cd-muted" role="status">Loading…</p>
    }
    else if (_error is { } error)
    {
      <p class="cd-error" role="alert">@error</p>
    }
    else if (_searched && !Shown.Any())
    {
      <p class="cd-empty">Nothing in the library matches (contents already in the post are left out).</p>
    }
    @if (_more)
    {
      <button type="button" class="mud-button-root mud-button-text mud-button-small" disabled="@_loading" @onclick="() => SearchAsync(reset: false)">More</button>
    }
  </div>

  @if (_selected is not null && _block is not null && Session.Document is { } document)
  {
    <div class="cd-library__preview" aria-label="Preview">
      <DesignBody Page="RenderMapping.Preview(document, _block!)" Settings="_settings" />
    </div>
    <div class="cd-library__add">
      <label class="cd-check"><input type="checkbox" @bind="_required" /> The post needs it (required)</label>
      <span class="cd-muted">@(Region is { } region ? $"Goes into {region}" : "Shows through \"items\" until you place it")</span>
      <button type="button" class="mud-button-root mud-button-filled mud-button-primary mud-button-small" disabled="@Session.Busy" @onclick="AddAsync">Add to the post</button>
    </div>
  }
</section>

@code {
  private const int PageSize = 20;
  [Parameter, EditorRequired] public StudioSession Session { get; set; } = default!;
  [Parameter] public EventCallback OnClose { get; set; }

  private string _field = "";
  private string _stage = "accepted";
  private string _unit = "";
  private IReadOnlyList<UnitName> _units = [];
  private readonly List<LibraryContent> _items = [];
  private bool _more;
  private bool _loading;
  private bool _searched;
  private string? _error;
  private LibraryItemDto? _selected;
  private soft.square.net.ContentDesigner.Rendering.Model.RenderBlock? _block;
  private bool _required;
  private RenderSettings _settings = new();

  /// <summary>The block fields to filter by: the post's, then any the workspace knows.</summary>
  private IEnumerable<string> Fields =>
    (Session.Workspace?.Contents.Select(c => c.FieldKey) ?? []).Concat(Session.Workspace?.BlockFields?.Keys ?? []).Distinct().Order(StringComparer.Ordinal);

  /// <summary>The library without what the post has already.</summary>
  private IEnumerable<LibraryContent> Shown =>
    _items.Where(i => Session.Workspace?.Contents.Any(c => c.ContentId == i.ContentId) != true);

  /// <summary>The region "Add" puts it in: the selected region, or the selected block's region; null: unplaced.</summary>
  private string? Region => Session.Current is not { } design ? null : Session.Selected switch
  {
    { } id when DesignEditor.IsRegion(id) && DesignEditor.FindRegion(design, DesignEditor.RegionId(id)) is not null => DesignEditor.RegionId(id),
    { } id when DesignEditor.FindPlacement(design, id) is { } placement => placement.RegionId,
    _ => null
  };

  private string UnitLabel(Guid id)
  {
    var unit = _units.FirstOrDefault(u => u.Id == id);
    return StudioText.Unit(id, unit?.NameEn, unit?.NameAr);
  }

  protected override async Task OnInitializedAsync()
  {
    _units = await Session.UnitsAsync();
    _settings = RenderMapping.Settings(HttpClients.CreateClient(HttpClientNames.WebApi).BaseAddress);
    await SearchAsync(reset: true);
  }

  private async Task SearchAsync(bool reset)
  {
    if (reset) { _items.Clear(); _selected = null; }
    _loading = true;
    _error = null;
    var page = await Session.LibraryAsync(Empty(_field), Empty(_stage), Guid.TryParse(_unit, out var unit) ? unit : null, _items.Count, PageSize);
    _loading = false;
    _searched = true;
    if (page is null) { _error = Session.Error; return; }
    _items.AddRange(page.Items);
    _more = page.More;
  }

  private async Task PreviewAsync(LibraryContent item)
  {
    if (_selected?.Content.ContentId == item.ContentId) return;
    _selected = await Session.LibraryItemAsync(item.ContentId);
    _block = _selected is null ? null : StudioJson.Convert<soft.square.net.ContentDesigner.Rendering.Model.RenderBlock>(_selected.Block);
    if (_selected is null) _error = Session.Error;
  }

  private async Task AddAsync()
  {
    if (_selected is not { } chosen) return;
    if (await Session.AttachAsync(chosen.Content.ContentId, _required, Region)) _selected = null;
  }

  private async Task RowKey(KeyboardEventArgs e, LibraryContent item)
  {
    if (e.Key is "Enter" or " ") await PreviewAsync(item);
  }

  private Task OnKey(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;

  private Task Close() => OnClose.InvokeAsync();

  private static string? Empty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

  private static string Short(string id) => id.Length > 8 ? id[..8] : id;
}
