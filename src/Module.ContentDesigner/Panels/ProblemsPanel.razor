@inherits StudioPanelBase
@*
  The checks of the views as edited (POST .../design/check with the unsaved views): the design rules, DynamicFields'
  validation, the JSON-LD essentials and the AMP page (each AMP issue a block causes names that block). Errors block
  publishing; warnings do not. What Content refused a step with (its validation: the feed, live, and 422 answers) shows
  here too, joined with the check's finding of the same node. A problem that names a placement or a region selects it, in its view.
  Selecting a part with problems elsewhere (the canvas, Structure) keeps the list to that part's problems until "Show all". Filter by view;
  the AMP page's CSS shows against AMP's limit. An edit (or a culture change) after a Check marks the report out of date.
*@

<div class="cd-panel cd-problems">
  <div class="cd-toolbar" role="toolbar" aria-label="Problems">
    <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-small"
            disabled="@(Session?.Views is null || Session.Checking)" @onclick="CheckAsync">
      @(Session?.Checking == true ? "Checking…" : "Check")
    </button>
    @if (Session?.Report is { } report)
    {
      <span class="@(report.Valid ? "cd-ok" : "cd-error")" role="status">
        @(report.Valid ? "Ready to publish" : $"{report.Errors} error(s)")@(report.Warnings > 0 ? $", {report.Warnings} warning(s)" : "")
      </span>
      @if (Session.ReportStale)
      {
        <span class="cd-warn" role="status">Out of date: the design changed since this check. Check again.</span>
      }
      else if (Session.Dirty)
      {
        <span class="cd-muted">(of the unsaved views)</span>
      }
    }
    @if (SelectedFilter is { } only)
    {
      <span class="cd-tag cd-problems__only" role="status">
        Only @(SelectedLabel(only))
        <button type="button" class="mud-button-root mud-button-text mud-button-small" @onclick="ShowAll">Show all</button>
      </span>
    }
    <span class="cd-studio__spacer"></span>
    <span class="cd-filter" role="radiogroup" aria-label="Show the problems of">
      @foreach (var (key, label) in Filters)
      {
        <button type="button" role="radio" aria-checked="@(_filter == key)"
                class="mud-button-root mud-button-small @(_filter == key ? "mud-button-filled mud-button-primary" : "mud-button-text")"
                @onclick="() => _filter = key">@label (@Count(key))</button>
      }
    </span>
  </div>
  @if (Session?.Report?.AmpCssBytes is { } css)
  {
    var limit = Session.Report.AmpCssLimit is > 0 and var l ? l : 75_000;
    var share = Math.Min(1.0, (double)css / limit);
    <div class="cd-budget @(share >= 1 ? "is-over" : share >= 0.8 ? "is-near" : "") @(Session.ReportStale ? "is-stale" : "")" title="AMP allows @limit.ToString("N0") bytes of custom CSS">
      <span class="cd-budget__label">AMP CSS @css.ToString("N0") / @limit.ToString("N0") bytes</span>
      <meter class="cd-budget__bar" min="0" max="@limit" low="@(limit * 8 / 10)" high="@limit" optimum="0" value="@css" aria-label="AMP CSS size"></meter>
    </div>
  }

  @if (Session is not null && (Session.Report is not null || _problems.Count > 0))
  {
    @if (_problems.Count == 0)
    {
      <p class="cd-ok">No problems.</p>
    }
    <ul class="cd-list @(Session.ReportStale ? "is-stale" : "")">
      @foreach (var problem in _problems.Where(Shows).OrderByDescending(p => p.Refused).ThenByDescending(p => p.Severity).ThenBy(p => p.View))
      {
        <li class="cd-list__item cd-problem cd-problem--@problem.Severity.ToString().ToLowerInvariant()" @onclick="() => Go(problem)">
          <span class="cd-problem__icon" aria-hidden="true">@(problem.Severity == ProblemSeverity.Error ? "✖" : "⚠")</span>
          <span class="cd-list__main">
            <span class="cd-list__title">@problem.Message</span>
            <span class="cd-list__meta">
              @if (problem.Refusal is { } refusal)
              {
                <span class="cd-tag cd-tag--warn">Content refused@(refusal.Action is { } action ? $": {action}" : "")</span>
              }
              <span class="cd-tag">@(problem.View is { } v ? Views.Label(v) : "all views")</span>
              <span class="cd-muted">@problem.Code</span>
              @if (NodeContent(problem.NodeId) is { } about)
              {
                <span class="cd-muted">@about</span>
              }
              @if (problem.Path is { Length: > 0 } path)
              {
                <span class="cd-muted">@path</span>
              }
            </span>
          </span>
        </li>
      }
    </ul>
  }
  else if (Session?.Error is { } error && Session.Report is null)
  {
    <p class="cd-error" role="alert">@error</p>
  }
  else
  {
    <p class="cd-empty">Not checked yet.</p>
  }
</div>

@code {
  private static readonly (string Key, string Label)[] Filters =
    [("", "All"), (Views.Mobile, "Mobile"), (Views.Tablet, "Tablet"), (Views.Desktop, "Desktop"), (Views.Amp, "AMP")];

  private string _filter = "";

  private IReadOnlyList<StudioProblem> _problems = [];

  // The part the list keeps to (a selection id), and the one this panel selected itself (a click on a problem
  // selects its part, and must not narrow the list it was clicked in).
  private string? _only;
  private string? _selectedHere;
  private string? _seen;

  protected override void OnSessionAttached()
  {
    _problems = Session?.Problems ?? [];
    _only = _seen = _selectedHere = null;
  }

  protected override void OnSessionChanged()
  {
    _problems = Session?.Problems ?? [];
    var selected = Session?.Selected;
    if (selected == _seen) return;
    _seen = selected;
    _only = selected is not null && selected != _selectedHere && Session!.ProblemsOf(selected).Count > 0 ? selected : null;
    _selectedHere = null;
  }

  /// <summary>The part the list keeps to now: only while it is still selected and still has problems.</summary>
  private string? SelectedFilter =>
    _only is { } only && Session?.Selected == only && _problems.Any(p => About(p, only)) ? only : null;

  private bool About(StudioProblem problem, string id) => ProblemTargets.IsAbout(problem, id, Session?.Views, Session?.Document);

  private void ShowAll() => _only = null;

  private string SelectedLabel(string id) =>
    id.StartsWith("content:", StringComparison.Ordinal) && StudioText.Content(Session!, id["content:".Length..]) is { Length: > 0 } content
      ? content
      : DesignEditor.IsRegion(id) ? "region " + DesignEditor.RegionId(id) : id;

  /// <summary>A problem of the whole design (no view) shows under every view; with a part selected, only that part's.</summary>
  private bool Shows(StudioProblem problem) =>
    (_filter.Length == 0 || problem.View is null || problem.View == _filter) && (SelectedFilter is not { } only || About(problem, only));

  private int Count(string filter) =>
    _problems.Count(p => (filter.Length == 0 || p.View is null || p.View == filter) && (SelectedFilter is not { } only || About(p, only)));

  /// <summary>The post's content a node belongs to, when it is one of the post's own.</summary>
  private WorkspaceContent? ContentOf(string? nodeId) =>
    nodeId is null ? null : Session?.Workspace?.Contents.FirstOrDefault(c => c.NodeId == nodeId);

  private string? NodeContent(string? nodeId) =>
    ContentOf(nodeId) is { } content ? StudioText.Content(Session!, content.ContentId) : null;

  private Task CheckAsync() => Session?.CheckAsync() ?? Task.CompletedTask;

  /// <summary>Selects what a problem is about, in its view: the content whose node it is in, else what its path names.</summary>
  private void Go(StudioProblem problem)
  {
    if (Session is null || ProblemTargets.Of(problem, Session.Views, Session.Document) is not { } target) return;
    if (target.View is { } view) Session.SelectView(view);
    _selectedHere = target.Id;
    Session.Select(target.Id);
  }
}
