@inherits StudioPanelBase
@*
  The checks of the views as edited (POST .../design/check with the unsaved views): the design rules, DynamicFields'
  validation, the JSON-LD essentials and the AMP page. Errors block publishing; warnings do not. A problem that names a
  placement or a region selects it, in its view.
*@

<div class="cd-panel cd-problems">
  <div class="cd-toolbar" role="toolbar" aria-label="Problems">
    <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-small"
            disabled="@(Session?.Views is null || Session.Checking)" @onclick="CheckAsync">
      @(Session?.Checking == true ? "Checking…" : "Check")
    </button>
    @if (Session?.Report is { } report)
    {
      <span class="@(report.Valid ? "cd-ok" : "cd-error")" role="status">
        @(report.Valid ? "Ready to publish" : $"{report.Errors} error(s)")@(report.Warnings > 0 ? $", {report.Warnings} warning(s)" : "")
      </span>
      @if (Session.Dirty)
      {
        <span class="cd-muted">(of the unsaved views)</span>
      }
    }
  </div>

  @if (Session?.Report is { } shown)
  {
    @if (shown.Problems.Count == 0)
    {
      <p class="cd-ok">No problems.</p>
    }
    <ul class="cd-list">
      @foreach (var problem in shown.Problems.OrderByDescending(p => p.Severity).ThenBy(p => p.View?.Value))
      {
        <li class="cd-list__item cd-problem cd-problem--@problem.Severity.ToString().ToLowerInvariant()" @onclick="() => Go(problem)">
          <span class="cd-problem__icon" aria-hidden="true">@(problem.Severity == ProblemSeverity.Error ? "✖" : "⚠")</span>
          <span class="cd-list__main">
            <span class="cd-list__title">@problem.Message</span>
            <span class="cd-list__meta">
              <span class="cd-tag">@(problem.View is { } v ? Views.Label(v.Value.ToString()) : "all views")</span>
              <span class="cd-muted">@problem.Code</span>
              @if (problem.Path is { Length: > 0 } path)
              {
                <span class="cd-muted">@path</span>
              }
            </span>
          </span>
        </li>
      }
    </ul>
  }
  else if (Session?.Error is { } error)
  {
    <p class="cd-error" role="alert">@error</p>
  }
  else
  {
    <p class="cd-empty">Not checked yet.</p>
  }
</div>

@code {
  private Task CheckAsync() => Session?.CheckAsync() ?? Task.CompletedTask;

  /// <summary>Selects what a problem's path names: /{view}/placements/{n} or /{view}/regions/{n}.</summary>
  private void Go(DesignProblem problem)
  {
    if (Session?.Views is not { } views) return;
    var segments = (problem.Path ?? "").Trim('/').Split('/');
    var view = problem.View?.Value.ToString()
      ?? Views.All.FirstOrDefault(v => string.Equals(v, segments.ElementAtOrDefault(0), StringComparison.OrdinalIgnoreCase));
    if (view is null) return;
    Session.SelectView(view);
    var design = DesignEditor.Resolve(views, view);
    if (segments.Length >= 3 && int.TryParse(segments[2], out var index))
    {
      if (segments[1] == "placements" && index < design.AllPlacements.Count) Session.Select(design.AllPlacements[index].Part);
      else if (segments[1] == "regions" && index < design.AllRegions.Count) Session.Select(DesignEditor.RegionPrefix + design.AllRegions[index].Id);
    }
  }
}
