@page "/contentdesigner/studio/{PostId:int}"
@inherits ContentDesignerPageBase
@implements IAsyncDisposable
@using soft.square.net.Share.All
@using soft.square.net.Module.ContentDesigner.Panels
@inject IStudioPanels Panels
@inject IPageContext PageContext
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IServiceProvider Services
@using Microsoft.AspNetCore.Components.Authorization
@using soft.square.net.ModularBlazor.Abstractions.Live

@*
  The designer studio of one post: a MudDock workspace whose panes are dock panels (the dock-panel contract), the
  studio's own and those other modules add for "contentdesigner". The page owns the session (the post, the views as
  edited, undo, the checks); every pane finds it by the post id the page puts in the page context ("content.post").
  The post's unit and categories show under the toolbar, read only: the newsroom workflow sets them. The studio is read
  only without the right to arrange the post. When that right goes while it is open (the live topic is revoked, or a 403
  after it was allowed), a banner says the shift ended, unsaved work is kept in the browser's storage, and the studio asks
  for the rights every few seconds; when they return it opens up again and does the save it owes.
  Hot reload (StudioHotReload): the page listens on Content's live topic for the post (content:post:{id}) and, on each
  message, reads the post's change feed and reloads what the sections changed; the feed also catches up after a reconnect
  or a gap. Without a live channel, while it is not connected, or when the topic is refused, it polls the feed every 4 s
  while the page is visible.

  Focus mode (the Focus button, Ctrl+Shift+F; Esc leaves it): the studio fills the window over the layout's chrome, as a
  fixed frame, so it works whatever layout the page has (no layout fills the "blank" role yet). It is a toggle on this
  page: the session, the unsaved edits and undo are untouched. ?focus=1 opens the page in focus mode, and the toggle keeps
  the address in step without navigating.
*@

<PageHeader Title="@Title" />

@* tabindex -1: a click on plain content focuses the studio, so its keys (Esc, Ctrl+Shift+F) reach it, not the body. *@
<div class="cd-studio @(_focus ? "cd-studio--focus" : "")" tabindex="-1" @ref="_root" @onkeydown="OnKeyAsync">
  <div class="cd-studio__bar" role="toolbar" aria-label="Studio">
    <a class="mud-button-root mud-button-text mud-button-small" href="contentdesigner">← Designs</a>
    <strong class="cd-studio__title" title="@_session?.Workspace?.Post.PublicId">@Title</strong>
    @if (_session?.Workspace is { } workspace)
    {
      <span class="cd-tag" title="@(workspace.Post.UrlPrefix is { Length: > 0 } prefix ? $"Kind (addresses under {prefix})" : "Kind")">@workspace.Post.Kind</span>
      @if (_session.Design?.Published is not null)
      {
        <span class="cd-tag cd-tag--ok">published</span>
      }
    }

    <span class="cd-views" role="tablist" aria-label="Views">
      @foreach (var view in Views.All)
      {
        var inherits = _session?.Views?[view].InheritsFrom;
        <button type="button" role="tab" aria-selected="@(_session?.View == view)"
                class="cd-views__tab @(_session?.View == view ? "is-active" : "")" disabled="@(_session?.Views is null)"
                title="@(inherits is null ? Views.Label(view) : $"{Views.Label(view)} inherits from {Views.Label(inherits)}")"
                @onclick="() => _session!.SelectView(view)">
          <span>@Views.Label(view)</span>
          @if (inherits is not null)
          {
            <span class="cd-views__inherits" aria-hidden="true">↰</span>
          }
        </button>
      }
    </span>

    <label class="cd-check"><input type="checkbox" checked="@(_session?.ShowHidden ?? true)" disabled="@(_session is null)"
                                   @onchange="e => _session!.SetShowHidden(e.Value is true)" /> Hidden</label>
    <select class="cd-select" aria-label="Direction" disabled="@(_session is null)" value="@(_session?.Direction ?? "")"
            @onchange="e => _session!.SetDirection(e.Value as string is { Length: > 0 } d ? d : null)">
      <option value="">Post's direction</option>
      <option value="ltr">LTR</option>
      <option value="rtl">RTL</option>
    </select>
    <input class="cd-input cd-input--short" aria-label="Culture" placeholder="culture" value="@_session?.Culture"
           disabled="@(_session is null)" @onchange="e => _session!.SetCultureAsync(e.Value as string)" />

    @if (_reload is { } reload)
    {
      <span class="cd-tag @(reload.Mode == StudioSync.Live ? "cd-tag--ok" : "")"
            title="@(reload.Mode == StudioSync.Live ? "Changes to the contents arrive live"
                    : reload.Refused is { } refused ? $"Live updates are not available for this post ({refused}): checking for changes every few seconds"
                    : "Checking for changes every few seconds")">@(reload.Mode == StudioSync.Live ? "live" : "polling")</span>
    }

    <span class="cd-studio__spacer"></span>

    <button type="button" class="mud-button-root mud-button-text mud-button-small" title="Undo (Ctrl+Z)"
            disabled="@(_session?.CanUndo != true || _session.Locked)" @onclick="() => _session!.Undo()">Undo</button>
    <button type="button" class="mud-button-root mud-button-text mud-button-small" title="Redo (Ctrl+Y)"
            disabled="@(_session?.CanRedo != true || _session.Locked)" @onclick="() => _session!.Redo()">Redo</button>
    <button type="button" class="mud-button-root mud-button-text mud-button-small" title="Back to the saved design"
            disabled="@(_session?.Dirty != true || _session.Locked)" @onclick="() => _session!.Revert()">Revert</button>
    <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-small"
            disabled="@(_session?.Views is null || _session.Checking)" @onclick="() => _session!.CheckAsync()">Check</button>
    <button type="button" class="mud-button-root mud-button-filled mud-button-primary mud-button-small"
            disabled="@(_session?.Dirty != true || _session.Busy)" @onclick="() => _session!.SaveAsync()">
      <span>Save</span>
      @if (_session?.Dirty == true)
      {
        <span class="cd-dirty" title="Unsaved changes">●</span>
      }
    </button>
    @if (_session?.Design?.Published is null)
    {
      <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-small"
              disabled="@(_session?.Design is null || _session.Busy || !_session.CanPublish)" title="@PublishHint"
              @onclick="() => _session!.PublishAsync()">Publish</button>
    }
    else
    {
      <button type="button" class="mud-button-root mud-button-outlined mud-button-small"
              disabled="@(_session.Busy || !_session.CanPublish)" title="@PublishHint" @onclick="() => _session!.PublishAsync()">Publish again</button>
      <button type="button" class="mud-button-root mud-button-text mud-button-small"
              disabled="@(_session.Busy || !_session.CanPublish)" title="@PublishHint" @onclick="() => _session!.UnpublishAsync()">Unpublish</button>
    }
    <button type="button" class="mud-button-root mud-button-text mud-button-small" title="The panes back where they started"
            disabled="@(_dock is null)" @onclick="ResetLayoutAsync">Reset layout</button>
    <button type="button" class="mud-button-root mud-button-small @(_focus ? "mud-button-filled mud-button-primary" : "mud-button-outlined")"
            aria-pressed="@_focus" title="@(_focus ? "Exit focus (Esc)" : "Fill the window (Ctrl+Shift+F)")" @onclick="() => SetFocusAsync(!_focus)">
      @(_focus ? "Exit focus" : "Focus")
    </button>
  </div>

  @if (_session?.Workspace?.Post is { } post)
  {
    <div class="cd-studio__post" aria-label="The post's unit and categories">
      <span><span class="cd-muted">Unit:</span>
        @if (post.UnitId is { } unitId)
        {
          <strong>@StudioText.Unit(unitId, post.UnitNameEn, post.UnitNameAr)</strong>
        }
        else
        {
          <strong>none yet</strong>
        }
      </span>
      <span><span class="cd-muted">Categories:</span>
        @if (post.Categories is { Count: > 0 } categories)
        {
          @foreach (var category in categories)
          {
            <span class="cd-tag">@Category(category)</span>
          }
        }
        else
        {
          <strong>none</strong>
        }
      </span>
      <span class="cd-muted">Set by the newsroom workflow.</span>
    </div>
  }

  @if (_session is { ShiftEnded: true })
  {
    <div class="cd-banner cd-banner--warn" role="alert">
      <strong>Your shift ended</strong>
      <span>You may not change this post's design now (your rights ended or changed).
        @if (_session.Dirty)
        {
          <text>@(_session.DraftKept ? "Your unsaved work is kept in this browser" : "Your unsaved work is kept only while this page stays open: the browser's storage is not available")@(_session.SavePending ? ", and is saved when your rights return." : ".")</text>
        }
        The studio opens again by itself when your rights return.</span>
    </div>
  }
  else if (_session is { Locked: true, Rights: { } rights })
  {
    <div class="cd-banner" role="status">
      <strong>Read only</strong>
      <span>@ReadOnlyReason(rights.Reason)</span>
    </div>
  }
  @if (_session?.OfferedCopy is { } copy)
  {
    <div class="cd-banner" role="status">
      <span>Unsaved work from @copy.At.ToLocalTime().ToString("g") is kept in this browser. The saved design changed since, so it was not applied.</span>
      <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-small" disabled="@_session.Locked"
              title="Brings your copy back as unsaved changes: saving them replaces the saved design" @onclick="() => _session!.RestoreCopy()">Use my copy</button>
      <button type="button" class="mud-button-root mud-button-text mud-button-small" @onclick="() => _session!.DiscardCopyAsync()">Discard my copy</button>
    </div>
  }

  @if (_session?.Error is { } error && _session.Views is null)
  {
    <p class="cd-error" role="alert">@error</p>
  }
  else if (_noPanels)
  {
    <p class="cd-error" role="alert">The studio's panes are not in your catalog. Ask an administrator to update the ContentDesigner module.</p>
  }
  <div class="cd-studio__dock" @ref="_host"></div>
  @if (_session?.LibraryOpen == true)
  {
    <LibraryPicker Session="_session" OnClose="() => _session.ShowLibrary(false)" />
  }
</div>

@code {
  private const string LayoutKey = "contentdesigner.studio.layout.v2"; // v2: Toolbox and Explorer, no Templates pane

  /// <summary>How often the studio asks for the caller's rights: a shift's rights end and return without a reload.</summary>
  private static readonly TimeSpan RightsEvery = TimeSpan.FromSeconds(15);

  [Parameter] public int PostId { get; set; }

  [CascadingParameter] private Task<AuthenticationState>? Authentication { get; set; }

  private StudioSession? _session;
  private ElementReference _host;
  private ElementReference _root;
  private IJSObjectReference? _dock;
  private string _dockPanels = "";
  private bool _noPanels;
  private CancellationTokenSource? _poll;
  private StudioHotReload? _reload;
  private int _openedFor;
  private bool _disposed;

  private bool _focus;

  private string Title => _session?.Workspace?.Post.Title is { Length: > 0 } title ? title : $"Post {PostId}";

  private string? PublishHint => _session is { CanPublish: false, Rights: not null } ? "You may not publish this post's design now" : null;

  private static string Category(WorkspaceCategory category)
  {
    var arabic = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    return (arabic ? category.NameAr ?? category.NameEn : category.NameEn ?? category.NameAr) ?? category.Id;
  }

  private static string ReadOnlyReason(string? reason) => reason switch
  {
    "no-unit" => "This post is in no unit yet: until the workflow assigns one, only the moderator and the Desk may arrange it.",
    "post-hidden" => "Content does not show you this post now.",
    _ => "Your rights cover neither this post's unit nor its press or categories. If your shift has not started, check in."
  };

  private async Task<string?> SignedInUserAsync()
  {
    if (Authentication is null) return null;
    var user = (await Authentication).User;
    return user.FindFirst("sub")?.Value ?? user.Identity?.Name;
  }

  private async Task WatchRightsAsync(StudioSession session, CancellationToken ct)
  {
    using var timer = new PeriodicTimer(RightsEvery);
    try
    {
      while (await timer.WaitForNextTickAsync(ct))
        if (session.Rights is not null && !await HiddenAsync()) await session.VerifyRightsAsync(ct);
    }
    catch (OperationCanceledException) { }
  }

  protected override async Task OnParametersSetAsync()
  {
    if (_openedFor == PostId) return;
    var postId = _openedFor = PostId;
    await CloseAsync();
    var user = await SignedInUserAsync();
    // The page may have been left, or have moved to another post, while it waited: then it opens nothing here.
    if (_disposed || _openedFor != postId || _session is not null) return;

    var session = _session = new StudioSession(postId, () => Api, Describe, (message, kind) => MudTail.ToastAsync(message, kind),
      new BrowserDraftStore(JS), user);
    session.Changed += OnSessionChanged;
    session.ProblemsWanted += OnProblemsWanted;
    StudioSessions.Add(session);
    PageContext.Set(StudioKeys.Post, postId.ToString(System.Globalization.CultureInfo.InvariantCulture));

    var opened = await session.OpenAsync();
    if (_disposed || !ReferenceEquals(_session, session)) return; // nothing to watch for a page that is gone
    if (opened)
    {
      _poll = new CancellationTokenSource();
      // Optional: a host without the live hub has no channel, and the studio polls.
      _reload = new StudioHotReload(postId, session.CatchUpAsync, () => session.LastEvent,
        Services.GetService(typeof(ILiveChannel)) as ILiveChannel, HiddenAsync);
      _reload.Changed += OnSessionChanged;
      var reload = _reload;
      var ct = _poll.Token;
      reload.Revoked += _ => InvokeAsync(() => session.SuspendAsync(ct));
      session.RightsReturned += () => _ = reload.RejoinAsync();
      _ = _reload.RunAsync(ct);
      _ = WatchRightsAsync(session, ct);
      await _reload.StartAsync(ct);
    }
  }

  protected override void OnInitialized()
  {
    Panels.Changed += OnPanelsChanged;
    _focus = FocusInAddress(Navigation.Uri);
  }

  // ───────────── focus mode ─────────────

  private static bool FocusInAddress(string uri) =>
    new Uri(uri).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries)
      .Any(pair => pair is "focus=1" or "focus=true" or "focus");

  /// <summary>Enters or leaves focus mode; the address follows (?focus=1) without a navigation (the dock and canvas lay out by CSS and resize observers).</summary>
  private async Task SetFocusAsync(bool focus)
  {
    if (_focus == focus) return;
    _focus = focus;
    StateHasChanged();
    var uri = new Uri(Navigation.Uri);
    var query = string.Join('&', uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries)
      .Where(pair => !pair.StartsWith("focus", StringComparison.Ordinal)).Append(focus ? "focus=1" : null).OfType<string>());
    var address = uri.GetLeftPart(UriPartial.Path) + (query.Length > 0 ? "?" + query : "") + uri.Fragment;
    try
    {
      await JS.InvokeVoidAsync("history.replaceState", null, "", address);
    }
    catch (JSException) { } // the address is a convenience; focus mode works without it
    if (focus)
    {
      try { await _root.FocusAsync(preventScroll: true); } // so Esc leaves at once
      catch (JSException) { }
    }
  }

  private Task OnKeyAsync(KeyboardEventArgs e)
  {
    if (e.Key == "Escape" && _focus && _session?.LibraryOpen != true) return SetFocusAsync(false);
    if (e.CtrlKey && e.ShiftKey && e.Key is "F" or "f") return SetFocusAsync(!_focus);
    return Task.CompletedTask;
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;
    await MountDockAsync();
    if (_focus)
    {
      try { await _root.FocusAsync(preventScroll: true); } // opened with ?focus=1: Esc leaves
      catch (JSException) { }
    }
  }

  private void OnSessionChanged() => InvokeAsync(StateHasChanged);

  private void OnPanelsChanged() => InvokeAsync(MountDockAsync);

  /// <summary>A part with problems was selected: the Problems panel comes forward (opened if it was closed).</summary>
  private void OnProblemsWanted() => InvokeAsync(async () =>
  {
    // The studio's own Problems panel: its contribution id is "{module id}:problems".
    var problems = Panels.For(StudioKeys.Studio, [StudioKeys.Post]).FirstOrDefault(p => p.Id.EndsWith(":problems", StringComparison.Ordinal));
    if (_dock is null || problems is null) return;
    try { await _dock.InvokeVoidAsync("show", problems.Id); }
    catch (JSDisconnectedException) { }
  });

  // ───────────── the dock ─────────────

  /// <summary>Creates the dock with every panel for the studio; again when the list changed (a module came or went).</summary>
  private async Task MountDockAsync()
  {
    var panels = Panels.For(StudioKeys.Studio, [StudioKeys.Post]);
    var ids = string.Join('|', panels.Select(p => p.Id));
    _noPanels = panels.Count == 0;
    if (ids == _dockPanels && _dock is not null) return;
    _dockPanels = ids;

    await MudTailInterop.DisposeHandleAsync(_dock);
    _dock = null;
    if (panels.Count == 0)
    {
      StateHasChanged();
      return;
    }

    var definitions = panels.Select(p => new
    {
      key = p.Id,
      title = p.LocalTitle,
      icon = StudioIcons.Svg(p.Icon), // MudDock takes markup; a contribution names a Lucide icon
      document = p.Document,
      component = StudioPanels.RootComponent,
    }).ToList();
    _dock = await MudTail.CreateAsync("dock", _host, new { storageKey = LayoutKey, layout = DefaultLayout(panels), definitions });
    StateHasChanged();
  }

  /// <summary>
  /// The first arrangement: contents, structure, toolbox and explorer on the left; the designer and output in the centre
  /// over problems and activity; properties and JSON-LD on the right. Other modules' panels join the area they asked for.
  /// </summary>
  private static object DefaultLayout(IReadOnlyList<ShellContribution> panels)
  {
    object Group(IEnumerable<ShellContribution> items, double weight) =>
      new { type = "group", weight, panels = items.Select(p => new { key = p.Id, title = p.LocalTitle }).ToList() };

    var documents = panels.Where(p => p.Document).ToList();
    var tools = panels.Where(p => !p.Document).ToList();
    var left = tools.Where(p => p.Area == DockPanelAreas.Left).ToList();
    var bottom = tools.Where(p => p.Area == DockPanelAreas.Bottom).ToList();
    var right = tools.Except(left).Except(bottom).ToList();

    var centre = new List<object>();
    if (documents.Count > 0) centre.Add(Group(documents, 3));
    if (bottom.Count > 0) centre.Add(Group(bottom, 1));

    var row = new List<object>();
    if (left.Count > 0) row.Add(Group(left, 1));
    if (centre.Count > 0) row.Add(new { type = "split", direction = "column", weight = 3.2, children = centre });
    if (right.Count > 0) row.Add(Group(right, 1.2));

    return new { version = 1, root = new { type = "split", direction = "row", weight = 1, children = row }, left = Array.Empty<object>(), right = Array.Empty<object>() };
  }

  private async Task ResetLayoutAsync()
  {
    if (_dock is null) return;
    try { await _dock.InvokeVoidAsync("resetLayout"); }
    catch (JSException) { }
  }

  // ───────────── hot reload ─────────────

  private async Task<bool> HiddenAsync()
  {
    try { return await JS.GetValueAsync<bool>("document.hidden"); }
    catch (JSException) { return false; }
  }

  // ───────────── closing ─────────────

  private async Task CloseAsync()
  {
    // Everything others can see goes at once, before any await: the next page must not meet a half-closed one.
    _poll?.Cancel();
    _poll?.Dispose();
    _poll = null;
    var reload = _reload;
    _reload = null;
    if (reload is not null) reload.Changed -= OnSessionChanged;
    if (_session is not null)
    {
      _session.Changed -= OnSessionChanged;
      _session.ProblemsWanted -= OnProblemsWanted;
      StudioSessions.Remove(_session);
      _session = null;
    }
    if (reload is not null) await reload.DisposeAsync();
  }

  public async ValueTask DisposeAsync()
  {
    _disposed = true;
    Panels.Changed -= OnPanelsChanged;
    var closed = CloseAsync(); // its session is gone before it returns
    if (StudioSessions.MayClearContext(PageContext.Get(StudioKeys.Post))) PageContext.Clear(StudioKeys.Post);
    await closed;
    await MudTailInterop.DisposeHandleAsync(_dock);
    _dock = null;
  }
}
