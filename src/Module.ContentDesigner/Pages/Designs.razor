@page "/contentdesigner"
@inherits ContentDesignerPageBase

@*
  A read-only overview until the designer studio arrives: the tenant's post designs a page at a time
  (GET /api/contentdesigner/designs), optionally of one kind, and the document templates
  (GET /api/contentdesigner/document-templates).
*@

<PageHeader Title="Designs" />

<div class="mud-container mn-page">
  <header class="mn-header">
    <div>
      <p class="mud-typography mud-typography-body1 mn-muted">
        How your organisation's posts are laid out: each post's design (Mobile, Tablet, Desktop and AMP views) and the
        templates new designs start from. Reading needs contentdesigner.read; the studio to arrange views comes next.
      </p>
    </div>
    <form class="mn-actions" @onsubmit="FilterAsync" @onsubmit:preventDefault>
      <div class="mud-input-control mn-inline">
        <label class="mud-input-label" for="mn-kind">Kind</label>
        <div class="mud-input-wrapper mud-input-wrapper--dense">
          <input id="mn-kind" type="search" class="mud-input-slot" @bind="_kind" placeholder="post.news" />
        </div>
      </div>
      <button type="submit" class="mud-button-root mud-button-outlined mud-button-primary mud-button-medium" disabled="@Busy">Show</button>
    </form>
  </header>

  @if (Error is not null)
  {
    <p class="mud-typography mud-typography-body2 mn-error" role="alert">@Error</p>
  }

  <section class="mud-paper mud-elevation-1 mn-card">
    <h2 class="mud-typography mud-typography-h6">Post designs</h2>
    <MudTailDataTable @ref="_designs" Columns="DesignColumns" EmptyText="No designs yet." />
    <div class="mn-pager">
      <span class="mud-typography mud-typography-body2 mn-muted">@PagerText</span>
      <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-small" @onclick="() => GoToAsync(_page - 1)" disabled="@(Busy || _page <= 1)">Previous</button>
      <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-small" @onclick="() => GoToAsync(_page + 1)" disabled="@(Busy || _page >= LastPage)">Next</button>
    </div>
  </section>

  <section class="mud-paper mud-elevation-1 mn-card">
    <h2 class="mud-typography mud-typography-h6">Document templates</h2>
    <MudTailDataTable @ref="_templates" Columns="TemplateColumns" EmptyText="No templates yet." />
  </section>
</div>

@code {
  private const int PageSize = 20;

  private static readonly IReadOnlyList<object> DesignColumns =
  [
    new { key = "post", title = "Post", type = "number", width = "90px" },
    new { key = "publicId", title = "Public id" },
    new { key = "kind", title = "Kind" },
    new { key = "published", title = "Published", width = "120px" },
    new { key = "updated", title = "Updated", width = "170px" },
  ];

  private static readonly IReadOnlyList<object> TemplateColumns =
  [
    new { key = "name", title = "Name" },
    new { key = "kind", title = "Kind" },
    new { key = "isDefault", title = "Default", width = "100px" },
    new { key = "description", title = "Description" },
    new { key = "updated", title = "Updated", width = "170px" },
  ];

  private MudTailDataTable? _designs;
  private MudTailDataTable? _templates;
  private int _page = 1;
  private int _total;
  private string _kind = "";

  private int LastPage => Math.Max(1, (_total + PageSize - 1) / PageSize);

  private string PagerText => _total == 0 ? "" : $"Page {_page} of {LastPage} ({_total} designs)";

  private string? Kind => string.IsNullOrWhiteSpace(_kind) ? null : _kind.Trim();

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender) await LoadAsync();
  }

  private async Task LoadAsync()
  {
    await RunAsync(async () =>
    {
      var designs = await Api.ListDesignsAsync(_page, PageSize, Kind);
      _total = designs.Total;
      if (_designs is not null) await _designs.SetDataAsync(designs.Items.Select(ToRow).ToList());

      var templates = await Api.ListDocumentTemplatesAsync(Kind);
      if (_templates is not null) await _templates.SetDataAsync(templates.Select(ToRow).ToList());
    });
  }

  private static object ToRow(DesignSummary d) => new
  {
    post = d.PostId.ToString(),
    publicId = d.PublicId,
    kind = d.Kind,
    published = d.Published ? $"v{d.PublishedVersion}" : "no",
    updated = When(d.UpdatedAt),
  };

  private static object ToRow(DocumentTemplateDto t) => new
  {
    name = t.Name,
    kind = $"{t.Kind} v{t.KindVersion}",
    isDefault = t.IsDefault ? "yes" : "",
    description = t.Description ?? "",
    updated = When(t.UpdatedAt),
  };

  private async Task GoToAsync(int page)
  {
    _page = Math.Clamp(page, 1, LastPage);
    await LoadAsync();
  }

  private async Task FilterAsync()
  {
    _page = 1;
    await LoadAsync();
  }
}
