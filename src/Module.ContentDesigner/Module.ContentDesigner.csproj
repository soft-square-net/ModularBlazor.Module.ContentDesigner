<Project Sdk="Microsoft.NET.Sdk.Razor">
  <Sdk Name="soft.square.net.ModularBlazor.Module.Sdk" />

  <!--
    The Blazor client module of ContentDesigner, loaded by ModularBlazor.BlzWebClient: for now a read-only Designs page (the
    post designs and the document templates) over the module's API; the designer studio comes next.

    Shipped as soft.square.net.Module.ContentDesigner.dll alone (the client part of the module). The API client is its own
    hidden client module (WebApi.Modules.ContentDesigner.Client, listed in Dependencies): referenced here to compile, never
    copied (Private=false). The host provides ModularBlazor.Abstractions (the Module SDK), Microsoft.Extensions.Http
    and the WebAssembly authentication package.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.*" PrivateAssets="all" />
    <ProjectReference Include="..\WebApi.Modules.ContentDesigner.Client\WebApi.Modules.ContentDesigner.Client.csproj" Private="false" />
  </ItemGroup>

</Project>
